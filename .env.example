# Copy to .env and adjust for your environment.
# Never commit a real .env file or any secret values.

# Human readable service name, used as the OpenAPI title.
APP_NAME=Agent WAF

# One of: development | staging | production
APP_ENV=development

# One of: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Prefix applied to every API route (no trailing slash).
API_PREFIX=/api/v1

# Backend listener. ECS injects PORT; Compose derives it from BACKEND_PORT.
HOST=0.0.0.0
PORT=8000
BACKEND_PORT=8000

# Comma-separated browser origins permitted to call the backend directly.
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=false

# Enable PostgreSQL policies/audits and Redis runtime state.
PERSISTENCE_ENABLED=false

# Required when PERSISTENCE_ENABLED=true. Supply credentials locally; never
# commit populated URLs. Use postgresql+psycopg:// and redis:// schemes.
DATABASE_URL=
REDIS_URL=

# SQLAlchemy connection and bootstrap controls.
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_CREATE_TABLES=true

# Redis namespace, connection timeout, and state retention.
REDIS_KEY_PREFIX=agent-waf
REDIS_SOCKET_TIMEOUT_SECONDS=5
REDIS_STATE_TTL_SECONDS=86400
IDEMPOTENCY_TTL_SECONDS=3600
IDEMPOTENCY_WAIT_TIMEOUT_SECONDS=30

# Docker Compose initializes its services from these values. Passwords are
# intentionally blank and Compose refuses to start until both are supplied.
POSTGRES_DB=agent_waf
POSTGRES_USER=agent_waf
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Required on POST /api/v1/tool-calls and POST /api/v1/agent/chat when set.
# Leave blank locally to disable API-key enforcement during development.
API_AUTH_KEY=

# Required only by POST /api/v1/agent/chat. Leave blank to run the gateway
# without the sample agent. The SDK still uses OPENAI_* names; point them at
# Groq (current deploy) or another OpenAI-compatible provider.
#
# Groq (current AWS deploy):
#   OPENAI_API_KEY=<from https://console.groq.com/keys>
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_MODEL=openai/gpt-oss-20b
#
# Gemini:
#   OPENAI_API_KEY=<from https://aistudio.google.com/app/apikey>
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   OPENAI_MODEL=gemini-2.0-flash
#
# OpenAI:
#   OPENAI_API_KEY=sk-...
#   OPENAI_MODEL=gpt-4.1-mini
#   (leave OPENAI_BASE_URL unset)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-20b
OPENAI_TIMEOUT_SECONDS=30

# ENFORCE blocks violations. SHADOW records WOULD_BLOCK and executes the tool.
WAF_ENFORCEMENT_MODE=ENFORCE
